# Copy to .env (kept out of git). Loaded from GTM_HOME, never from the current directory.

# Supabase: session pooler URL (port 5432, *.pooler.supabase.com), service role. Never the direct db.*.supabase.co host.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Providers. A missing key disables that leg; the play still runs with whatever is configured.
APOLLO_API_KEY=
FULLENRICH_API_KEY=
MILLIONVERIFIER_API_KEY=
PDL_API_KEY=
CRUSTDATA_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Optional defaults
GTM_MAX_CREDITS_PER_RUN=50

# Phase 2 providers (all optional; a missing key disables the corresponding legs)
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
LEADMAGIC_API_KEY=
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
SERPER_API_KEY=
THEIRSTACK_API_KEY=
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
LUSHA_API_KEY=
KASPR_API_KEY=
# HubSpot private app token (crm.objects.contacts/companies read+write)
HUBSPOT_TOKEN=

# LinkedIn signals (HarvestAPI, pull only) and outbound alerts
HARVESTAPI_API_KEY=
SLACK_WEBHOOK_URL=

# Judgment inside the plays (account briefs, sequence drafts). Without it the plays still run:
# facts and a rules-based summary, template drafts flagged for rewrite.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5 at low effort. claude-haiku-5-5 is the cheapest option for extraction and short copy.
GTM_LLM_MODEL=

# Social listening (Reddit, X) and JS-page rendering, both pay-as-you-go
SCRAPECREATORS_API_KEY=
SCRAPEGRAPH_API_KEY=

# SEC EDGAR asks for a contact User-Agent on its free API (Form D funding filings)
SEC_USER_AGENT="Your Company contact@yourcompany.com"

{
  "name": "gtm-harness",
  "version": "0.1.0",
  "description": "GTM Harness: CLI-first GTM engine driven by a coding agent; source, enrich, detect signals, score and sync to HubSpot with your own provider keys, on Supabase.",
  "type": "module",
  "private": true,
  "bin": { "gtm": "./bin/gtm.mjs" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:routing": "node --import tsx scripts/routing-eval.ts --verbose",
    "gtm": "node bin/gtm.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "commander": "^14.0.0",
    "csv-parse": "^6.0.0",
    "csv-stringify": "^6.5.0",
    "dotenv": "^17.0.0",
    "postgres": "^3.4.0",
    "tldts": "^7.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
